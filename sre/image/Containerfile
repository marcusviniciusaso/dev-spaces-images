ARG SRE_IMAGE=quay.io/vflorent/devspaces-sre:0.8
ARG BASE_IMAGE=quay.io/marolive/custom-udi:1.2.7

# ---- Stage 1: consolidate SRE filesystem into a single layer ----
FROM ${SRE_IMAGE} AS sre-source

RUN mkdir -p /tmp/sre-export; \
    for d in usr/local/bin usr/local/lib usr/local/share \
             usr/bin usr/lib64 usr/share \
             opt etc/profile.d; do \
      if [ -d "/$d" ]; then \
        mkdir -p "/tmp/sre-export/$d"; \
        cp -a "/$d/." "/tmp/sre-export/$d/" 2>/dev/null || true; \
      fi; \
    done

# ---- Stage 2: merge SRE tools into custom-udi ----
FROM ${BASE_IMAGE}

USER 0

COPY --from=sre-source /tmp/sre-export/ /tmp/sre-merge/

RUN set -euo pipefail; \
    for d in usr/local/bin usr/local/lib usr/local/share \
             usr/bin usr/lib64 usr/share \
             opt etc/profile.d; do \
      if [ -d "/tmp/sre-merge/$d" ]; then \
        mkdir -p "/$d"; \
        cp -a -n "/tmp/sre-merge/$d/." "/$d/" 2>/dev/null || true; \
      fi; \
    done; \
    rm -rf /tmp/sre-merge; \
    chown -R 10001:0 /home/user 2>/dev/null || true; \
    ldconfig 2>/dev/null || true

USER 10001
