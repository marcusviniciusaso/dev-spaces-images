ARG BASE_IMAGE=quay.io/marolive/custom-udi:3.0.9
FROM ${BASE_IMAGE}

USER 0

ARG MAVEN_VERSION_ARG=3.9.12
ARG CHROME_VERSION_ARG=152.0.7977.64
ARG JMETER_VERSION_ARG=5.6.3

# ---- JDK ----
RUN set -euo pipefail; \
    PM="microdnf"; command -v microdnf >/dev/null 2>&1 || PM="dnf"; \
    $PM install -y java-25-openjdk-devel; \
    $PM clean all;

# ---- Maven ----
RUN set -euo pipefail; \
    curl -fsSL -o /tmp/maven.tgz \
      "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION_ARG}/binaries/apache-maven-${MAVEN_VERSION_ARG}-bin.tar.gz"; \
    mkdir -p /opt/maven; \
    tar -C /opt/maven -xzf /tmp/maven.tgz; \
    ln -s "/opt/maven/apache-maven-${MAVEN_VERSION_ARG}" /opt/maven/current; \
    ln -sf /opt/maven/current/bin/mvn /usr/local/bin/mvn; \
    rm -f /tmp/maven.tgz; \
    chown -R 10001:0 /opt/maven

# ---- Chrome runtime dependencies ----
RUN set -euo pipefail; \
    PM="microdnf"; command -v microdnf >/dev/null 2>&1 || PM="dnf"; \
    $PM install -y \
      nss nspr atk at-spi2-atk cups-libs libdrm libxkbcommon \
      libXcomposite libXdamage libXrandr mesa-libgbm alsa-lib \
      pango cairo; \
    $PM clean all

# ---- Chrome for Testing + chromedriver (paired version) ----
RUN set -euo pipefail; \
    mkdir -p /opt/chrome; \
    curl -fsSL -o /tmp/chrome.zip \
      "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION_ARG}/linux64/chrome-linux64.zip"; \
    unzip -q /tmp/chrome.zip -d /tmp/chrome-unpack; \
    mv /tmp/chrome-unpack/chrome-linux64 "/opt/chrome/chrome-${CHROME_VERSION_ARG}"; \
    ln -s "/opt/chrome/chrome-${CHROME_VERSION_ARG}" /opt/chrome/current; \
    ln -sf /opt/chrome/current/chrome /usr/local/bin/chrome; \
    rm -rf /tmp/chrome.zip /tmp/chrome-unpack; \
    \
    curl -fsSL -o /tmp/chromedriver.zip \
      "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION_ARG}/linux64/chromedriver-linux64.zip"; \
    unzip -q /tmp/chromedriver.zip -d /tmp/chromedriver-unpack; \
    mv /tmp/chromedriver-unpack/chromedriver-linux64 "/opt/chrome/chromedriver-${CHROME_VERSION_ARG}"; \
    ln -sf "/opt/chrome/chromedriver-${CHROME_VERSION_ARG}/chromedriver" /usr/local/bin/chromedriver; \
    rm -rf /tmp/chromedriver.zip /tmp/chromedriver-unpack; \
    \
    chown -R 10001:0 /opt/chrome

# ---- Apache JMeter ----
RUN set -euo pipefail; \
    curl -fsSL -o /tmp/jmeter.tgz \
      "https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION_ARG}.tgz"; \
    mkdir -p /opt/jmeter; \
    tar -C /opt/jmeter -xzf /tmp/jmeter.tgz; \
    ln -s "/opt/jmeter/apache-jmeter-${JMETER_VERSION_ARG}" /opt/jmeter/current; \
    rm -f /tmp/jmeter.tgz; \
    chown -R 10001:0 /opt/jmeter; \
    chmod -R g+rwX /opt/jmeter

# ---- Utilitarios de troca de JDK + wrapper do JMeter ----
COPY --chmod=0644 scripts/use-java.sh /etc/profile.d/05-java-versions.sh
COPY --chmod=0755 scripts/with-java /usr/local/bin/with-java
COPY --chmod=0755 scripts/jmeter-wrapper.sh /usr/local/bin/jmeter

# ---- Plano JMeter de exemplo (smoke test sem egress) ----
COPY --chmod=0644 examples/index.html examples/smoke-plan.jmx /opt/jmeter/examples/

# ---- Scripts shell + dotfiles ----
COPY --chown=10001:0 --chmod=0644 \
     scripts/.bashrc \
     scripts/devspaces-environment.sh \
     scripts/devspaces-setup.sh \
     /home/tooling/

# ---- Environment config (profile.d) + permissoes + comandos devspaces-* ----
RUN set -euo pipefail; \
    printf 'export JAVA_HOME="/usr/lib/jvm/java-21-openjdk";\nexport PATH="$JAVA_HOME/bin:$PATH";\n' \
      > /etc/profile.d/00-java-tools.sh; \
    printf 'export MAVEN_HOME="/opt/maven/current";\nexport PATH="$MAVEN_HOME/bin:$PATH";\n' \
      > /etc/profile.d/10-maven.sh; \
    printf 'export CHROME_BIN="/usr/local/bin/chrome";\nexport WEBDRIVER_CHROME_DRIVER="/usr/local/bin/chromedriver";\nexport PATH="/opt/chrome/current:$PATH";\n' \
      > /etc/profile.d/20-chrome.sh; \
    printf 'export JMETER_HOME="/opt/jmeter/current";\n' \
      > /etc/profile.d/30-jmeter.sh; \
    chmod 0644 /etc/profile.d/00-java-tools.sh /etc/profile.d/10-maven.sh \
               /etc/profile.d/20-chrome.sh /etc/profile.d/30-jmeter.sh; \
    \
    printf '%s\n' \
      '' \
      'if ! declare -F use-java >/dev/null 2>&1 && [ -r /etc/profile.d/05-java-versions.sh ]; then' \
      '    . /etc/profile.d/05-java-versions.sh' \
      'fi' \
      >> /etc/bashrc; \
    \
    chown -R 10001:0 /opt/jmeter/examples; \
    \
    chmod 0755 /home/tooling/devspaces-setup.sh /home/tooling/devspaces-environment.sh; \
    \
    install -m 0644 -o 10001 -g 0 /home/tooling/.bashrc       /home/user/.bashrc; \
    \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-setup.sh "$@"' \
      > /usr/local/bin/devspaces-setup; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-environment.sh "$@"' \
      > /usr/local/bin/devspaces-environment; \
    chmod 0755 /usr/local/bin/devspaces-setup /usr/local/bin/devspaces-environment

ENV JAVA_HOME="/usr/lib/jvm/java-21-openjdk" \
    JAVA_HOME_25="/usr/lib/jvm/java-25-openjdk" \
    USE_JAVA21="true" \
    MAVEN_HOME="/opt/maven/current" \
    JMETER_HOME="/opt/jmeter/current" \
    CHROME_BIN="/usr/local/bin/chrome" \
    WEBDRIVER_CHROME_DRIVER="/usr/local/bin/chromedriver" \
    DBUS_SESSION_BUS_ADDRESS="/dev/null" \
    PATH="/usr/lib/jvm/java-21-openjdk/bin:/opt/maven/current/bin:/opt/chrome/current:${PATH}"

USER 10001
