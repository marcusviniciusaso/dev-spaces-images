ARG BASE_IMAGE=quay.io/marolive/custom-udi:3.1.1
FROM ${BASE_IMAGE}

USER 0

ARG NODE22_VERSION_ARG=22.23.1
ARG NODE24_VERSION_ARG=24.18.0
ARG NODE25_VERSION_ARG=25.9.0
ARG NODE_DEFAULT_MAJOR_ARG=24

# Um unico COPY: os scripts sao instalados no RUN abaixo com dono/modo finais.
COPY scripts/ /tmp/build-scripts/

RUN set -euo pipefail; \
    PM="microdnf"; command -v microdnf >/dev/null 2>&1 || PM="dnf"; \
    $PM install -y xz tar; \
    $PM clean all; \
    arch="${TARGETARCH:-}"; \
    if [ -z "$arch" ]; then \
      uarch="$(uname -m)"; \
      case "$uarch" in \
        x86_64) arch="amd64" ;; \
        aarch64|arm64) arch="arm64" ;; \
        *) echo "Unsupported arch: $uarch" && exit 1 ;; \
      esac; \
    fi; \
    case "$arch" in \
      amd64) node_arch="x64" ;; \
      arm64) node_arch="arm64" ;; \
      *) echo "Unsupported TARGETARCH: $arch" && exit 1 ;; \
    esac; \
    for node_version in "${NODE22_VERSION_ARG}" "${NODE24_VERSION_ARG}" "${NODE25_VERSION_ARG}"; do \
      echo "=== Node.js ${node_version} ==="; \
      curl -fsSL -o /tmp/node.tar.xz \
        "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-${node_arch}.tar.xz"; \
      mkdir -p "/opt/node/versions/${node_version}"; \
      tar -C "/opt/node/versions/${node_version}" --strip-components=1 -xJf /tmp/node.tar.xz; \
      test -x "/opt/node/versions/${node_version}/bin/node"; \
      rm -f /tmp/node.tar.xz; \
    done; \
    chown -R 10001:0 /opt/node; \
    chmod -R g=u /opt/node; \
    rm -rf /home/user/.npm; \
    \
    echo "=== Utilitarios de troca de versao do Node ==="; \
    install -m 0644 /tmp/build-scripts/fnm-common.sh    /usr/local/bin/fnm-common.sh; \
    install -m 0755 /tmp/build-scripts/nodeuse.sh       /usr/local/bin/nodeuse; \
    install -m 0755 /tmp/build-scripts/nodelist.sh      /usr/local/bin/nodelist; \
    install -m 0755 /tmp/build-scripts/node-versions.sh /usr/local/bin/node-versions; \
    \
    echo "=== Environment config (profile.d) ==="; \
    printf '%s\n' \
      'export NODE_VERSION_DIR="/opt/node/versions"' \
      'if [ -d /home/user/persistent ] && [ -w /home/user/persistent ]; then' \
      '    export NODE_STATE_DIR="${NODE_STATE_DIR:-/home/user/persistent/.node}"' \
      'else' \
      '    export NODE_STATE_DIR="${NODE_STATE_DIR:-/home/user/.node}"' \
      'fi' \
      'export NODE_CURRENT_FILE="${NODE_CURRENT_FILE:-$NODE_STATE_DIR/current}"' \
      'if [ -r /usr/local/bin/fnm-common.sh ]; then' \
      '    . /usr/local/bin/fnm-common.sh' \
      '    ensure_node_state' \
      '    apply_node_target "$(read_node_target)" >/dev/null 2>&1 || true' \
      'fi' \
      > /etc/profile.d/20-node.sh; \
    chmod 0644 /etc/profile.d/20-node.sh; \
    \
    mkdir -p /home/user/.node; \
    echo "${NODE_DEFAULT_MAJOR_ARG}" > /home/user/.node/current; \
    chown -R 10001:0 /home/user/.node; \
    chmod -R g=u /home/user/.node; \
    \
    echo "=== Scripts shell + dotfiles + comandos devspaces-* ==="; \
    install -m 0644 -o 10001 -g 0 /tmp/build-scripts/.bashrc                  /home/tooling/.bashrc; \
    install -m 0755 -o 10001 -g 0 /tmp/build-scripts/devspaces-environment.sh /home/tooling/devspaces-environment.sh; \
    install -m 0755 -o 10001 -g 0 /tmp/build-scripts/devspaces-setup.sh       /home/tooling/devspaces-setup.sh; \
    install -m 0644 -o 10001 -g 0 /home/tooling/.bashrc                       /home/user/.bashrc; \
    \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-setup.sh "$@"' \
      > /usr/local/bin/devspaces-setup; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-environment.sh "$@"' \
      > /usr/local/bin/devspaces-environment; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec cat /etc/devspaces-linux-release' \
      > /usr/local/bin/devspaces-linux-release; \
    chmod 0755 /usr/local/bin/devspaces-setup /usr/local/bin/devspaces-environment /usr/local/bin/devspaces-linux-release; \
    \
    rm -rf /tmp/build-scripts

ENV NODE_VERSION_DIR="/opt/node/versions" \
    NODE_STATE_DIR="/home/user/.node" \
    NODE_DEFAULT_MAJOR="24" \
    PATH="/opt/node/versions/24.18.0/bin:${PATH}"

USER 10001
