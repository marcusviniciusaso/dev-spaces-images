ARG UDI_IMAGE=registry.redhat.io/devspaces/udi-rhel9:3.28.2-1780929707

FROM ${UDI_IMAGE}

USER 0

ARG OCP_VERSION=4.20.27
ARG HELM_VERSION=v3.16.2
ARG KIND_VERSION=v0.26.0

COPY --chown=user:root --chmod=755 scripts/entrypoint.sh /entrypoint.sh
COPY --chmod=0644 scripts/release-notes.yaml /etc/devspaces-linux-release

RUN set -euo pipefail; \
    arch="${TARGETARCH:-}"; \
    if [ -z "$arch" ]; then \
      uarch="$(uname -m)"; \
      case "$uarch" in \
        x86_64) arch="amd64" ;; \
        aarch64|arm64) arch="arm64" ;; \
        *) echo "Unsupported arch: $uarch" && exit 1 ;; \
      esac; \
    fi; \
    \
    PM="microdnf"; command -v microdnf >/dev/null 2>&1 || PM="dnf"; \
    REQUIRED="gnupg2 ca-certificates unzip zip jq git tree bash-completion iputils vim-enhanced shadow-utils"; \
    $PM install -y $REQUIRED; \
    if $PM install -y traceroute; then \
        echo "traceroute instalado"; \
    else \
        echo "traceroute não encontrado, usar fallback (tracepath)"; \
    fi; \
    \
    rpm --import https://packages.microsoft.com/keys/microsoft.asc; \
    dnf install -y https://packages.microsoft.com/config/rhel/9.0/packages-microsoft-prod.rpm; \
    dnf install -y azure-cli; \
    \
    dnf install -y 'dnf-command(config-manager)'; \
    dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo; \
    dnf install -y gh --repo gh-cli; \
    \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/cache/yum; \
    \
    curl -fsSL -o /tmp/ocp-client.tar.gz \
      "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-4.20/openshift-client-linux.tar.gz"; \
    tar -C /tmp -xzf /tmp/ocp-client.tar.gz; \
    install -m 0755 /tmp/oc /usr/local/bin/oc; \
    if [ -f /tmp/kubectl ]; then install -m 0755 /tmp/kubectl /usr/local/bin/kubectl; fi; \
    rm -rf /tmp/oc /tmp/kubectl /tmp/README.md /tmp/ocp-client.tar.gz; \
    \
    curl -fsSL -o /tmp/helm.tgz \
      "https://get.helm.sh/helm-${HELM_VERSION}-linux-${arch}.tar.gz"; \
    tar -C /tmp -xzf /tmp/helm.tgz; \
    install -m 0755 "/tmp/linux-${arch}/helm" /usr/local/bin/helm; \
    rm -rf /tmp/helm.tgz "/tmp/linux-${arch}"; \
    \
    curl -fsSL -o /usr/local/bin/kind \
      "https://kind.sigs.k8s.io/dl/${KIND_VERSION}/kind-linux-${arch}"; \
    chmod 0755 /usr/local/bin/kind; \
    \
    pip3 install --no-cache-dir -U cekit podman-compose; \
    python3.11 -m venv /opt/podman-mcp; \
    /opt/podman-mcp/bin/pip install --no-cache-dir --upgrade pip; \
    /opt/podman-mcp/bin/pip install --no-cache-dir podman-mcp 'mcp>=1.0.0,<2'; \
    ln -s /opt/podman-mcp/bin/podman-mcp /usr/local/bin/podman-mcp; \
    \
    curl -fsSL https://gh.io/copilot-install | bash; \
    \
    mkdir -p /etc/bash_completion.d; \
    (kubectl completion bash > /etc/bash_completion.d/kubectl || true); \
    (oc completion bash > /etc/bash_completion.d/oc || true); \
    (helm completion bash > /etc/bash_completion.d/helm || true); \
    gh completion -s bash > /etc/bash_completion.d/gh; \
    \
    if ! command -v traceroute >/dev/null 2>&1; then \
        printf '#!/bin/bash\nexec tracepath "${1:-8.8.8.8}"\n' > /usr/local/bin/traceroute; \
        chmod +x /usr/local/bin/traceroute; \
    fi; \
    \
    if ! command -v lsb_release >/dev/null 2>&1; then \
        printf '#!/bin/bash\nsource /etc/os-release\ncase "${1:-}" in\n  -a|"") echo "Distributor ID:\t${ID}"; echo "Description:\t${PRETTY_NAME}"; echo "Release:\t${VERSION_ID}"; echo "Codename:\t${VERSION_CODENAME:-}";;\n  -si) echo "${ID}" ;;\n  -sr) echo "${VERSION_ID}" ;;\n  -sd) echo "${PRETTY_NAME}" ;;\n  *) echo "Uso: lsb_release [-a|-si|-sr|-sd]" >&2; exit 2 ;;\nesac\n' > /usr/local/bin/lsb_release; \
        chmod +x /usr/local/bin/lsb_release; \
    fi; \
    \
    if ! command -v code >/dev/null 2>&1; then \
        printf '#!/bin/bash\nif command -v code-oss >/dev/null 2>&1; then\n    exec code-oss "$@"\nelse\n    echo "[ERRO] CLI do VS Code (code-oss) não encontrada." >&2\n    exit 1\nfi\n' > /usr/local/bin/code; \
        chmod +x /usr/local/bin/code; \
    fi; \
    \
    printf '%s\n' \
      '[nexus-interno]' \
      'name=Repositorio Interno Nexus' \
      'baseurl=NEXUS_BASEURL_PLACEHOLDER' \
      'enabled=1' \
      'gpgcheck=0' \
      'sslverify=0' \
      'priority=1' \
      > /etc/yum.repos.d/nexus-repo; \
    chmod 666 /etc/yum.repos.d/nexus-repo; \
    \
    rm -rf /tmp/* /var/tmp/* /root/.cache

LABEL org.opencontainers.image.title="Dev Spaces Custom UDI" \
      org.opencontainers.image.description="UDI customizada para Dev Spaces 3.28" \
      org.opencontainers.image.source="https://github.com/marcusviniciusaso/custom-udi" \
      org.opencontainers.image.vendor="Red Hat (sample)" \
      org.opencontainers.image.version="3.0.6"

USER 10001
