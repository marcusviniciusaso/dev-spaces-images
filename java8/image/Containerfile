ARG BASE_IMAGE=quay.io/marolive/custom-udi:3.0.11
FROM ${BASE_IMAGE}

USER 0

ARG GRADLE_VERSION_ARG=7.6.6
ARG SPRING_BOOT_VERSION_ARG=2.7.18

# ---- JDK ----
RUN set -euo pipefail; \
    PM="microdnf"; command -v microdnf >/dev/null 2>&1 || PM="dnf"; \
    $PM install -y java-1.8.0-openjdk-devel; \
    $PM clean all;

# ---- Gradle + Spring Boot CLI ----
RUN set -euo pipefail; \
    curl -fsSL -o /tmp/gradle.zip \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION_ARG}-bin.zip"; \
    mkdir -p /opt/gradle; \
    unzip -q /tmp/gradle.zip -d /opt/gradle; \
    ln -s "/opt/gradle/gradle-${GRADLE_VERSION_ARG}" /opt/gradle/current; \
    ln -sf /opt/gradle/current/bin/gradle /usr/local/bin/gradle; \
    rm -f /tmp/gradle.zip; \
    chown -R 10001:0 /opt/gradle; \
    \
    curl -fsSL -o /tmp/sbcli.tgz \
      "https://repo.maven.apache.org/maven2/org/springframework/boot/spring-boot-cli/${SPRING_BOOT_VERSION_ARG}/spring-boot-cli-${SPRING_BOOT_VERSION_ARG}-bin.tar.gz"; \
    mkdir -p /opt/spring-boot-cli; \
    tar -C /opt/spring-boot-cli -xzf /tmp/sbcli.tgz; \
    ln -sf "/opt/spring-boot-cli/spring-${SPRING_BOOT_VERSION_ARG}/bin/spring" /usr/local/bin/spring; \
    rm -f /tmp/sbcli.tgz; \
    chown -R 10001:0 /opt/spring-boot-cli

# ---- Scripts shell + dotfiles ----
COPY --chown=10001:0 --chmod=0644 \
     scripts/.bashrc \
     scripts/devspaces-environment.sh \
     scripts/devspaces-setup.sh \
     /home/tooling/

# ---- Environment config (profile.d) + permissoes + comandos devspaces-* ----
RUN set -euo pipefail; \
    printf 'export JAVA_HOME="/usr/lib/jvm/java-1.8.0-openjdk";\nexport PATH="$JAVA_HOME/bin:$PATH";\n' \
      > /etc/profile.d/00-java-tools.sh; \
    printf 'export GRADLE_HOME="/opt/gradle/current";\nexport PATH="$GRADLE_HOME/bin:$PATH";\n' \
      > /etc/profile.d/11-gradle.sh; \
    chmod 0644 /etc/profile.d/00-java-tools.sh /etc/profile.d/11-gradle.sh; \
    \
    chmod 0755 /home/tooling/devspaces-setup.sh /home/tooling/devspaces-environment.sh; \
    \
    install -m 0644 -o 10001 -g 0 /home/tooling/.bashrc /home/user/.bashrc; \
    \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-setup.sh "$@"' \
      > /usr/local/bin/devspaces-setup; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec bash /home/tooling/devspaces-environment.sh "$@"' \
      > /usr/local/bin/devspaces-environment; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'exec cat /etc/devspaces-linux-release' \
      > /usr/local/bin/devspaces-linux-release; \
    chmod 0755 /usr/local/bin/devspaces-setup /usr/local/bin/devspaces-environment /usr/local/bin/devspaces-linux-release

ENV JAVA_HOME="/usr/lib/jvm/java-1.8.0-openjdk" \
    USE_JAVA8="true" \
    GRADLE_HOME="/opt/gradle/current" \
    PATH="/usr/lib/jvm/java-1.8.0-openjdk/bin:/opt/gradle/current/bin:${PATH}"

USER 10001
